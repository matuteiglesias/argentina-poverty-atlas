{
  "name": "argentina-poverty-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data:project": "node scripts/project-fixture-release.mjs",
    "predev": "npm run data:project",
    "dev": "vite",
    "prebuild": "npm run data:project",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src vite.config.ts",
