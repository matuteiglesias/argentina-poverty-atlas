{
  "schema_version": "atlas-poverty-consumer-profile/v1",
  "producer": "matuteiglesias/indice-pobreza-UBA",
  "accepted_release_schema": "poverty-estimate-release/v2",
  "required_files": [
    "poverty_estimates.csv",
    "capabilities.json",
    "geography_join_contract.json",
    "release_manifest.json",
    "run_qa.json",
    "LIMITATIONS.md",
    "checksums.sha256"
  ],
  "accepted_scientific_status": [
    "synthetic_fixture",
    "research_estimate"
  ],
  "required_geometry_semantics": {
    "geometry_embedded": false,
    "geometry_owner": "matuteiglesias/argentina-geography",
    "join_key": [
      "geography_level",
      "geography_id"
    ],
    "join_semantics": "exact_governed_id"
  },
  "required_fact_fields": [
    "release_id",
    "estimation_period",
    "frame_vintage",
    "universe",
    "geography_level",
    "geography_id",
    "concept",
    "estimand",
    "estimate",
    "unit",
    "weighted_numerator",
    "weighted_denominator",
    "coverage",
    "design_id",
    "weight_semantics",
    "uncertainty_status"
  ],
  "supported_units": [
    "proportion"
  ],
  "supported_uncertainty_status": [
    "not_supplied"
  ],
  "capability_discovery": {
    "file": "capabilities.json",
    "schema_version": "poverty-estimate-capabilities/v1",
    "selector_policy": "offer_only_declared_availability_cells"
  },
  "scientific_rules": {
    "browser_aggregation_allowed": false,
    "browser_scientific_recalculation_allowed": false,
    "fuzzy_geography_join_allowed": false,
    "numeric_geography_coercion_allowed": false,
    "manufacture_uncertainty_allowed": false,
    "synthetic_fixture_requires_demo_label": true,
    "research_estimate_requires_non_official_label": true
  },
  "unknown_semantics_policy": "reject_until_profile_is_versioned",
  "supported_geography_profiles": {
    "province_2010": {
      "id_regex": "^[0-9]{2}$",
      "expected_geographies": 24
    },
    "department_2010": {
      "id_regex": "^[0-9]{5}$",
      "expected_geographies": 525
    }
  },
  "presentation_release_set": {
    "schema_version": "atlas-poverty-release-set/v1",
    "scientific_release_unit": "one period x one geography level",
    "concatenation_only": true,
    "scientific_recalculation_allowed": false,
    "canonical_department_periods": [
      "2024-Q1",
      "2024-Q2",
      "2024-Q3",
      "2024-Q4",
      "2025-Q1",
      "2025-Q2",
      "2025-Q3",
      "2025-Q4"
    ]
  }
}
